<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up results, profile and preferences, but never the API key (secrets.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
